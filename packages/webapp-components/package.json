{
  "name": "@ziioapp/webapp-components",
  "version": "0.1.0",
  "type": "module",
  "description": "Composable mobile web application components built on @ziioapp/ui",
  "license": "MIT",
  "author": "ziioai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziioai/ziioapp-ui.git",
    "directory": "packages/webapp-components"
  },
  "homepage": "https://github.com/ziioai/ziioapp-ui#readme",
  "bugs": {
    "url": "https://github.com/ziioai/ziioapp-ui/issues"
  },
  "keywords": [
    "react",
    "base-ui",
    "mobile",
    "webapp",
    "components",
    "ziioapp"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx",
    "./styles.css": "./src/styles/index.css",
    "./styles/source.css": "./src/styles/index.css",
    "./styles/image-viewer.css": "./src/styles/image-viewer.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build-package.mjs",
    "prepack": "pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": {
    "@ziioapp/ui": "^0.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.16.0",
    "react-bottom-fixed": "^0.2.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@types/react": "catalog:toolchain",
    "@types/react-dom": "catalog:toolchain",
    "@ziioapp/ui": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "4.3.0",
    "typescript": "catalog:toolchain"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "import": "./dist/components/*.js"
      },
      "./blocks/*": {
        "types": "./dist/blocks/*.d.ts",
        "import": "./dist/blocks/*.js"
      },
      "./styles.css": "./dist/styles/index.css",
      "./styles/source.css": "./dist/styles/index.css",
      "./styles/image-viewer.css": "./dist/styles/image-viewer.css",
      "./package.json": "./package.json"
    },
    "registry": "https://registry.npmjs.org/"
  }
}
