{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@ziioapp/ui/*": [
        "./src/*"
      ],
      "@ziioapp/ui/components/*": [
        "./src/shadcn/components/*"
      ],
      "@ziioapp/ui/hooks/use-mobile": [
        "./src/shadcn/hooks/use-mobile"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/components"
  ]
}
