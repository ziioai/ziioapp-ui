{
  "name": "@ziioapp/framework",
  "version": "0.1.0",
  "description": "Application shell, theme runtime, and shared views for ZiioApp",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./basic/*": "./src/basic/*.tsx",
    "./config/*": "./src/config/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./layouts/*": "./src/layouts/*.tsx",
    "./platform/*": "./src/platform/*.ts",
    "./providers/*": "./src/providers/*.tsx",
    "./styles/*": "./src/styles/*",
    "./types/*": "./src/types/*",
    "./utils/*": "./src/utils/*.ts",
    "./views/*": "./src/views/*.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build-package.mjs",
    "prepack": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.23.12",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@types/react": "catalog:toolchain",
    "@types/react-dom": "catalog:toolchain",
    "@ziioapp/ui": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "catalog:toolchain",
    "vite": "catalog:toolchain"
  },
  "peerDependencies": {
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@ziioapp/ui": "^0.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./basic/*": {
        "types": "./dist/basic/*.d.ts",
        "import": "./dist/basic/*.js"
      },
      "./config/*": {
        "types": "./dist/config/*.d.ts",
        "import": "./dist/config/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "import": "./dist/hooks/*.js"
      },
      "./layouts/*": {
        "types": "./dist/layouts/*.d.ts",
        "import": "./dist/layouts/*.js"
      },
      "./platform/*": {
        "types": "./dist/platform/*.d.ts",
        "import": "./dist/platform/*.js"
      },
      "./providers/*": {
        "types": "./dist/providers/*.d.ts",
        "import": "./dist/providers/*.js"
      },
      "./styles/*": "./dist/styles/*",
      "./types/*": "./dist/types/*",
      "./utils/*": {
        "types": "./dist/utils/*.d.ts",
        "import": "./dist/utils/*.js"
      },
      "./views/*": {
        "types": "./dist/views/*.d.ts",
        "import": "./dist/views/*.js"
      },
      "./package.json": "./package.json"
    },
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "author": "ziioai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziioai/ziioapp-ui.git",
    "directory": "packages/framework"
  },
  "homepage": "https://github.com/ziioai/ziioapp-ui#readme",
  "bugs": {
    "url": "https://github.com/ziioai/ziioapp-ui/issues"
  },
  "keywords": [
    "react",
    "application-shell",
    "theme",
    "ziioapp"
  ]
}
