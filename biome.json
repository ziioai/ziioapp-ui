{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!artifacts",
      "!!packages/ui/upstream",
      "!!packages/ui/src/shadcn",
      "!!packages/ui/src/components",
      "!!packages/ui/src/styles",
      "!!packages/framework/src/styles/source.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
